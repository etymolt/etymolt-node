{
  "name": "@etymolt/sdk",
  "version": "0.2.0",
  "description": "Official TypeScript / Node SDK for Etymolt — the fact-check layer for LLM-generated names.",
  "license": "Apache-2.0",
  "author": "Etymolt <hello@etymolt.com>",
  "homepage": "https://etymolt.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/etymolt/etymolt-node.git"
  },
  "bugs": {
    "url": "https://github.com/etymolt/etymolt-node/issues"
  },
  "keywords": [
    "etymolt",
    "evp",
    "verdict",
    "trademark",
    "brand-clearance",
    "naming",
    "uspto",
    "fact-check",
    "ai",
    "llm"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
